#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="/opt/vaultwarden"
LOCK_FILE="/run/lock/vaultwarden-maintenance.lock"

usage() {
  cat <<'USAGE'
用法：
  sudo vaultwarden-restore <备份.tar.gz>

默认只恢复 vw-data，不恢复域名、Compose 和 Caddy 配置。
恢复前会再创建一份冷备份，并要求输入 RESTORE 确认。
USAGE
}

require_root() {
  [[ ${EUID} -eq 0 ]] || { echo "错误：请使用 sudo 执行。" >&2; exit 1; }
}

wait_alive() {
  local url=$1 i
  for i in $(seq 1 45); do
    curl -fsS --max-time 5 "${url}/alive" >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

main() {
  require_root
  [[ $# -eq 1 ]] || { usage; exit 2; }
  local archive=$1
  [[ -f $archive ]] || { echo "错误：备份文件不存在：$archive" >&2; exit 1; }
  archive=$(readlink -f "$archive")

  [[ -f $APP_DIR/.env && -f $APP_DIR/compose.yaml ]] || {
    echo "错误：未发现 Vaultwarden 部署。" >&2
    exit 1
  }

  exec 9>"$LOCK_FILE"
  flock -n 9 || { echo "错误：另一个 Vaultwarden 维护任务正在运行。" >&2; exit 1; }

  local confirm
  echo "将使用以下备份覆盖当前 Vaultwarden 数据："
  echo "  $archive"
  read -r -p "请输入 RESTORE 继续：" confirm
  [[ $confirm == "RESTORE" ]] || { echo "已取消。"; exit 0; }

  # shellcheck disable=SC1090
  . "$APP_DIR/.env"

  local safety tmp ts old_dir new_dir
  safety=$(VW_LOCK_HELD=1 /usr/local/sbin/vaultwarden-backup --cold --keep 30)
  echo "恢复前安全备份：$safety"

  tmp=$(mktemp -d "$APP_DIR/backups/.restore-XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  tar -xzf "$archive" -C "$tmp"

  [[ -f $tmp/vw-data/db.sqlite3 ]] || {
    echo "错误：备份中缺少 vw-data/db.sqlite3。" >&2
    exit 1
  }
  [[ $(sqlite3 "$tmp/vw-data/db.sqlite3" 'PRAGMA integrity_check;') == "ok" ]] || {
    echo "错误：备份数据库完整性检查失败。" >&2
    exit 1
  }

  ts=$(date '+%Y%m%d-%H%M%S')
  old_dir="$APP_DIR/vw-data.before-restore-$ts"
  new_dir="$APP_DIR/vw-data.restore-new-$ts"

  cp -a "$tmp/vw-data" "$new_dir"
  cd "$APP_DIR"
  docker compose stop vaultwarden
  mv "$APP_DIR/vw-data" "$old_dir"
  mv "$new_dir" "$APP_DIR/vw-data"
  docker compose up -d vaultwarden

  if wait_alive "$VW_URL"; then
    echo "恢复完成。恢复前数据目录保留在：$old_dir"
    exit 0
  fi

  echo "错误：恢复后的服务未通过健康检查，正在还原原数据目录。" >&2
  docker compose stop vaultwarden || true
  mv "$APP_DIR/vw-data" "$APP_DIR/vw-data.failed-restore-$ts"
  mv "$old_dir" "$APP_DIR/vw-data"
  docker compose up -d vaultwarden
  exit 1
}

main "$@"
