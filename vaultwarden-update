#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="/opt/vaultwarden"
ENV_FILE="$APP_DIR/.env"
LOCK_FILE="/run/lock/vaultwarden-maintenance.lock"

require_root() {
  [[ ${EUID} -eq 0 ]] || { echo "错误：请使用 sudo 执行。" >&2; exit 1; }
}

wait_alive() {
  local url=$1 i
  for i in $(seq 1 45); do
    if curl -fsS --max-time 5 "${url}/alive" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

main() {
  require_root
  [[ -f $ENV_FILE && -f $APP_DIR/compose.yaml ]] || {
    echo "错误：未发现 Vaultwarden 部署。" >&2
    exit 1
  }

  exec 9>"$LOCK_FILE"
  flock -n 9 || { echo "错误：另一个 Vaultwarden 维护任务正在运行。" >&2; exit 1; }

  # shellcheck disable=SC1090
  . "$ENV_FILE"
  cd "$APP_DIR"
  docker compose config --quiet

  local old_vw old_caddy backup_file
  old_vw=$(docker inspect -f '{{.Image}}' vaultwarden)
  old_caddy=$(docker inspect -f '{{.Image}}' vaultwarden-caddy)

  echo "先执行一致性冷备份……"
  backup_file=$(VW_LOCK_HELD=1 /usr/local/sbin/vaultwarden-backup --cold --keep 14)
  echo "备份：$backup_file"

  echo "拉取新镜像并重建容器……"
  docker compose pull
  docker compose up -d --remove-orphans

  if wait_alive "$VW_URL"; then
    echo "更新完成。"
    docker compose ps
    docker inspect -f 'Vaultwarden: {{.Config.Image}}  {{.Image}}' vaultwarden
    docker inspect -f 'Caddy:       {{.Config.Image}}  {{.Image}}' vaultwarden-caddy
    echo "未自动清理旧镜像，以便必要时回滚。"
    exit 0
  fi

  echo "错误：新版本健康检查失败，开始回滚镜像……" >&2
  docker compose logs --tail=100 vaultwarden caddy >&2 || true

  docker tag "$old_vw" vaultwarden/server:latest
  docker tag "$old_caddy" caddy:2
  docker compose up -d --force-recreate --remove-orphans

  if wait_alive "$VW_URL"; then
    echo "已回滚到更新前镜像。更新前备份：$backup_file" >&2
  else
    echo "严重错误：镜像回滚后服务仍未恢复。请执行 sudo vaultwarden-status，并保留备份：$backup_file" >&2
  fi
  exit 1
}

main "$@"
